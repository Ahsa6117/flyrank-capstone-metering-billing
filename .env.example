# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# A committed Stripe key -- even a test one -- is an instant repo-hygiene fail.

# --- database ---------------------------------------------------------------
# SQLite by default: no Docker, no server, runs anywhere.
DATABASE_URL=sqlite:///./data/billing.db
# Postgres alternative (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://billing:billing@localhost:5432/billing

# --- app --------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Protects POST /internal/jobs/run. Change this to any random string.
INTERNAL_JOB_TOKEN=replace-with-a-random-string

# --- stripe (TEST MODE ONLY) ------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys -- must start with sk_test_.
# The app REFUSES TO START if given an sk_live_ key.
STRIPE_SECRET_KEY=sk_test_replace_me

# Printed by `stripe listen --forward-to localhost:8000/webhooks/stripe`.
# A Dashboard endpoint secret and a CLI secret are DIFFERENT -- do not mix them.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price ID of your test-mode recurring "Pro" price (starts with price_).
STRIPE_PRICE_ID_PRO=price_replace_me

STRIPE_SUCCESS_URL=http://localhost:8000/billing/success
STRIPE_CANCEL_URL=http://localhost:8000/billing/cancel

# Seconds of clock skew tolerated on a webhook timestamp. Stripe's default is
# 300. NEVER set this to 0 -- that disables replay protection entirely.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
